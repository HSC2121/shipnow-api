
# ShipNow API - Environment Configuration
# Copy this file to .env for local development.

NODE_ENV=development
PORT=8080

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/shipnow

# Logging: fatal, error, warning, info, http, debug
LOG_LEVEL=debug

# Optional: configure only when an external integration is used
EXTERNAL_SERVICE_URL=
